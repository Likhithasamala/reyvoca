{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/seo-check.mjs --hook",
            "timeout": 30,
            "statusMessage": "SEO gate"
          }
        ]
      }
    ]
  }
}

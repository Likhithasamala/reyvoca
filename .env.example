# Reyvoca environment variables
# Copy to .env.local for local development. Never commit real values.

# Public site URL used for canonical links, OpenGraph URLs and the sitemap.
# Production example: https://reyvoca.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Reyvoca API. The backend ships inside this same Next.js app
# (app/api/*), so the same-origin relative path is the default.
# Leave empty to run the frontend with no backend: sign-in and sign-up then
# report that accounts are not open yet.
NEXT_PUBLIC_API_URL=/api

# Reyvoca operators: who may open /admin and change the provider stack.
# Comma-separated emails of signed-in accounts. Customers never see providers.
# Unset in development, the panel is open to the local machine; unset in
# production, nobody can reach it and /admin answers 404.
REYVOCA_ADMIN_EMAILS=

# Sarvam Voice Agents (Samvaad). Server-only — never prefix with NEXT_PUBLIC_.
# Org and workspace ids are on indus.sarvam.ai → Settings → API Key.
# SAMVAAD_APP_ID is the general-purpose agent described in docs/samvaad.md.
# Optional SAMVAAD_APP_VERSION pins a committed version (latest otherwise).
SAMVAAD_API_KEY=
SAMVAAD_ORG_ID=
SAMVAAD_WORKSPACE_ID=
SAMVAAD_APP_ID=
SAMVAAD_APP_VERSION=

# --- Email delivery (Resend) -------------------------------------------------
# Needed for: confirm-your-address, password reset, email change, and the
# "your password was changed" notice. Server-only.
#
# Unset, nothing is sent: links are printed to the terminal running `next dev`
# and listed in the operator mailbox at /admin/mailbox, so every flow can be
# walked through locally. Set the key and mail goes out for real.
#
# Get a key at resend.com -> API Keys. REYVOCA_MAIL_FROM must be an address on
# a domain verified with Resend; their sandbox sender works for testing.
RESEND_API_KEY=
REYVOCA_MAIL_FROM="Reyvoca <noreply@reyvoca.com>"

# --- Google sign-in (OAuth 2.0) ----------------------------------------------
# Unset, the "Continue with Google" button stays disabled and says so; email
# and password still work. Server-only: never prefix either with NEXT_PUBLIC_.
#
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application. Add these exactly:
#   Authorised JavaScript origin:  http://localhost:3000
#   Authorised redirect URI:       http://localhost:3000/api/auth/google/callback
# Add the production equivalents (https://reyvoca.com/...) before going live.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

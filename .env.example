# Reyvoca environment variables
# Copy to .env.local for local development. Never commit real values.

# Public site URL used for canonical links, OpenGraph URLs and the sitemap.
# Production example: https://reyvoca.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the Reyvoca API. The backend ships inside this same Next.js app
# (app/api/*), so the same-origin relative path is the default.
# Leave empty to run the frontend with no backend: sign-in and sign-up then
# report that accounts are not open yet.
NEXT_PUBLIC_API_URL=/api
